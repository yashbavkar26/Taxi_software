# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taxi_database
DB_CHARSET=utf8mb4

# Importer Configuration
BATCH_SIZE=1000
# Duplicate mode for unique keys (drivers table): 'skip', 'upsert', or 'fail'
DUPLICATE_MODE=skip
# Automatically register unknown drivers in drivers table with NULL contact
AUTO_REGISTER_DRIVERS=true

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
